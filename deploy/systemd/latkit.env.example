# latkit environment configuration — the single systemd config surface (Р34/Р47).
#
#   sudo mkdir -p /etc/latkit && sudo cp latkit.env.example /etc/latkit/latkit.env
#   sudo systemctl restart latkit
#
# Every LATKIT_* variable mirrors a CLI flag; precedence is
# flag > LATKIT_* env > (OTEL_* env for the OTLP group) > built-in default.
# Verify the resolved config without touching BPF:
#   sudo env $(grep -v '^#' /etc/latkit/latkit.env | xargs) latkit --print-config
#
# Boolean variables accept 1/true/yes/on (anything else = off).
# Everything below is commented out and shows the built-in default.

# ---------------------------------------------------------------------------
# Capture filters — all active filters combine with AND (port AND comm AND cgroup)
# ---------------------------------------------------------------------------

# Local (server) ports to capture, comma-separated, up to 16. Each port may
# carry its wire protocol as PORT=proto (proto = pg | mysql | http | s3 | redis;
# a bare number defaults to pg) and, after a colon, a per-port capture budget in
# bytes. One agent can watch all of them — this variable takes the whole list in
# one value (the CLI flag is repeatable instead, one port per -p), e.g.:
#   LATKIT_PORT=5432,3306=mysql,8080=http
#   LATKIT_PORT=9000=s3            # MinIO / any S3-compatible server
#   LATKIT_PORT=6379=redis         # Redis / Valkey / KeyDB / Dragonfly
#   LATKIT_PORT=6379=redis,26379=redis   # ... and Sentinel, the same protocol
#   LATKIT_PORT=443=http:4096      # 4 KiB per send/recv call on this port
# The budget defaults to LATKIT_CAPTURE_LIMIT for a database port, to 2048 for
# an http or s3 one (only request/response heads are ever parsed — plus a short
# prefix of an *error* body on an s3 port, which is where the S3 code lives — so
# copying a gigabyte of response body into the ringbuf would buy nothing), and
# to 512 for a redis one, where a command is a verb and a key and a value is
# never read at all.
#
# `s3` is the same HTTP/1.1 wire read under the object store's nouns: operation
# instead of route, bucket instead of Host, the access key out of the signature
# as `user`, the symbolic S3 error code out of the XML body. On a DISTRIBUTED
# MinIO capture the client port only — the inter-node grid is a binary protocol
# inside a websocket and a declared blind zone; requests to /minio/* that arrive
# on the client port are counted as latkit_s3_internal_requests_total and become
# no observation.
#
# `redis` is RESP2/RESP3 — Redis, Valkey, KeyDB, Dragonfly and Sentinel are the
# same wire. Two things to know before setting it:
#   - CAPTURE IS ON tcp_sendmsg/tcp_recvmsg, SO A UNIX-SOCKET CLIENT IS INVISIBLE.
#     Check with `redis-cli config get unixsocket`; the official images and the
#     Debian/Ubuntu packages ship it off, the Alpine package ships it ON. If your
#     application connects that way, this agent sees nothing at all — point it at
#     TCP (127.0.0.1 still goes through the hooks) or accept the gap.
#   - a CLUSTER's bus (client port + 10000) is binary gossip, not RESP: capture
#     the client port only. `-MOVED`/`-ASK` replies on it are counted as
#     redirects rather than errors, so a resharding cluster does not read as an
#     outage.
# Raise the budget for a keyspace-scanning workload: an array reply longer than
# the budget cannot be skipped arithmetically the way a bulk can, so that command
# is not observed (`LATKIT_PORT=6379=redis:4096`). See deploy/existing-redis.
#LATKIT_PORT=5432

# Only capture send/recv from processes with this exact comm. NOTE for MySQL:
# this matches the per-THREAD comm, and MySQL 8.x names its session threads
# `connection` (not `mysqld`) — do NOT set this to `mysqld` on 8.x or every
# event is dropped. The port filter already scopes the capture (MYSQL.md М5).
# The same trap applies to web servers: nginx worker threads and a Go server's
# threads are not named after the binary, and to Redis: with `io-threads N` most
# of the socket work happens on threads named `io_thd_1…N`, and a filter of
# `redis-server` alone was measured seeing 28 % of the traffic (a trailing `*`
# matches a prefix: `LATKIT_COMM=redis-server,io_thd_*`). Leave it unset unless
# you have read the comm you actually want out of /proc/<pid>/task/*/comm. MinIO
# is the one server where the obvious value is also the right one — every thread
# of it is named `minio` — but the filter applies to EVERY captured port, so
# setting it on a host that also runs a database silences that database.
#LATKIT_COMM=postgres

# Only capture traffic from cgroups whose path under /sys/fs/cgroup matches
# these globs (comma-separated; * stays within a path segment, ** spans
# segments). Requires cgroup v2. Example for a docker-run postgres:
#   LATKIT_CGROUP=system.slice/docker-*.scope
#LATKIT_CGROUP=

# ---------------------------------------------------------------------------
# Capture tuning
# ---------------------------------------------------------------------------

# BPF ringbuf size in bytes, power of two in [4096, 1G]. Grow when
# latkit_ringbuf_dropped_total is non-zero under your peak load.
#LATKIT_RINGBUF_BYTES=8388608

# Capture budget per send/recv call, bytes (1..16384). Payload past the budget
# is not copied, but message accounting stays honest (total_len).
#LATKIT_CAPTURE_LIMIT=8192

# Userspace connection table ceiling; least recently active entries are
# evicted past it.
#LATKIT_MAX_CONNS=65536

# Evict connections without events for this many seconds.
#LATKIT_CONN_IDLE_TIMEOUT=600

# ---------------------------------------------------------------------------
# Metrics shaping
# ---------------------------------------------------------------------------

# Distinct normalised queries tracked before the rest fold into query="other".
# The main cardinality knob: series ≈ queries × (db,user) pairs.
#LATKIT_TOP_QUERIES=500

# Max characters of the normalised text kept as the `query` label.
#LATKIT_QUERY_LABEL_LEN=256

# Also record latkit_query_first_row_seconds (time to first row; doubles the
# query-labelled series count). Boolean.
#LATKIT_FIRST_ROW_HIST=0

# ---------------------------------------------------------------------------
# HTTP observation (only meaningful with an `=http` port above)
# ---------------------------------------------------------------------------
# A URL space is unbounded by construction, so the `route` label is a TEMPLATE
# and the top-K limit above bounds it whether or not the template is right.
# Watch the route="other" share on the HTTP dashboard: that is the number that
# says whether the templating is working on YOUR API.

# Pin the routes instead of letting the heuristic guess them: a file of
# `METHOD /path/{id}` patterns, one per line, first match wins; anything
# unmatched still falls through to the heuristic. Format and trade-offs:
# deploy/demo-http/routes.map. Under ProtectSystem=strict the file must be
# readable by the unit — /etc/latkit is.
#LATKIT_HTTP_ROUTES=/etc/latkit/routes.map

# Path segments kept in a route label; deeper paths end in /... (1..32).
#LATKIT_HTTP_ROUTE_DEPTH=8

# Query-string keys whose VALUE is part of the route, comma-separated (for APIs
# where ?action=... is the endpoint). Every other key and value is dropped
# before the label. Each key here multiplies the series count.
#LATKIT_HTTP_QUERY_KEYS=

# Take the route from this request header when the application sends one. OFF
# by default and deliberately so: that header is client-controllable input, and
# only the top-K limit stands between it and your series count.
#LATKIT_HTTP_ROUTE_HEADER=

# `basic` derives the `user` label from the name half of Authorization: Basic
# (the password is never decoded; Bearer tokens are never touched). Default
# `none` — most HTTP has no user, and a user label is a cardinality multiplier.
#LATKIT_HTTP_USER=none

# Redact credential-looking query values (token, sig, password, key, code, ...)
# with *** wherever a request target leaves the handler — spans included — and
# blank credential headers in the debug dump. ON by default; spelled as a value
# rather than a bare boolean so that turning it OFF is visible in a review.
#LATKIT_HTTP_REDACT=on

# ---------------------------------------------------------------------------
# S3 observation (only meaningful with an `=s3` port above)
# ---------------------------------------------------------------------------
# Unlike an HTTP route, the identity of an S3 request needs no heuristic: it is
# an OPERATION, derived from (method, path shape, query keys) through a table of
# ~45 values (docs/notes-s3proto.md). An unknown call is op="other" — watch that
# share on the dashboard: it is a freshness signal about the table, not a
# cardinality guard. THE OBJECT KEY IS NEVER A LABEL, under any setting.

# Virtual-host addressing: a Host of the form <bucket>.NAME means the bucket
# comes from the Host rather than from the first path segment. Comma-separated;
# this is the same value the server gets in MINIO_DOMAIN. Without it every
# request is read path-style — which is also what MinIO does without MINIO_DOMAIN.
#LATKIT_S3_DOMAIN=

# `accesskey` derives the `user` label from the access key in the request's
# signature (Authorization: AWS4-HMAC-SHA256 Credential=<AK>/... or a presigned
# X-Amz-Credential) — the PUBLIC half of the pair. The signature itself, the
# per-chunk signatures and X-Amz-Security-Token are never read. An anonymous
# request is user="-". `off` drops the label entirely.
# Cardinality: ephemeral STS credentials can invent access keys faster than any
# dictionary wants, so the (bucket,user) dimension ceiling is raised to 128 for
# an s3 port automatically (32 elsewhere) and everything past it spills into
# user="other". `latkit --print-config` prints the resolved value.
#LATKIT_S3_USER=accesskey

# ---------------------------------------------------------------------------
# Redis observation (only meaningful with an `=redis` port above)
# ---------------------------------------------------------------------------
# The identity of a Redis command needs no heuristic either: it is the verb from
# a closed table of ~250 values, plus the subcommand for the fifteen container
# commands (CONFIG|GET, XINFO|STREAM). KEYS, VALUES AND ARGUMENTS ARE NEVER
# LABELS, under any setting — the second element of an ordinary command is a key
# and is not read. `cmd="other"` is a module command or a fork's own verb, and
# its share is a freshness signal about the table.

# `acl` derives the `user` label from the ACL user of `AUTH <user> <pass>` or
# `HELLO … AUTH <user> <pass>` — the NAME only. The password is a separate
# element of the same array, is never read, and is blanked before the
# --messages --hexdump view prints anything. `off` drops the label entirely.
# The `db` label (the SELECTed database) has no switch: a database number
# creates no cardinality worth a knob.
#LATKIT_REDIS_USER=acl

# ---------------------------------------------------------------------------
# Prometheus exposition
# ---------------------------------------------------------------------------

# Address for /metrics and /healthz; 'none' disables the listener.
# The default binds loopback (Р29) — scraping from another host needs 0.0.0.0
# (there is no TLS/auth on this endpoint; keep it inside your scrape network).
#LATKIT_PROM_LISTEN=127.0.0.1:9752

# ---------------------------------------------------------------------------
# OTLP push exporter (optional; also honours the standard OTEL_* variables)
# ---------------------------------------------------------------------------

# Collector base URL (http:// only); setting it enables the exporter.
# Falls back to $OTEL_EXPORTER_OTLP_ENDPOINT.
#LATKIT_OTLP_ENDPOINT=http://collector:4318

# Export period, seconds.
#LATKIT_OTLP_INTERVAL=15

# service.name in the OTLP resource. Falls back to $OTEL_SERVICE_NAME.
#LATKIT_OTLP_SERVICE_NAME=latkit

# Extra request headers (auth), comma-separated K=V pairs.
# Falls back to $OTEL_EXPORTER_OTLP_HEADERS.
#LATKIT_OTLP_HEADERS=authorization=Bearer secret

# Extra resource attributes, comma-separated K=V pairs.
# Falls back to $OTEL_RESOURCE_ATTRIBUTES.
#LATKIT_OTLP_RESOURCE=deployment.environment=prod

# Sample this fraction [0,1] of queries as OTLP spans. Off by default.
# SECURITY: spans carry literal SQL unless LATKIT_OTLP_SPAN_MASKED is set (Р32).
# On an http port a sampled observation becomes a SPAN_KIND_SERVER span, and if
# the request carried a W3C `traceparent` it joins THAT trace as a child of the
# caller — the agent's view of the request appears inside your existing
# distributed trace with nothing instrumented in the server (РH11). A span is
# also the only path by which a url.path (redacted) leaves the host.
#LATKIT_OTLP_SPANS=0

# Additionally sample every query at least this many ms long as a span.
#LATKIT_OTLP_SPANS_SLOW_MS=0

# Cap db.query.text at this many bytes.
#LATKIT_OTLP_SPAN_TEXT_MAX=4096

# Send the normalised (literal-free) SQL as db.query.text instead of the raw
# text. Boolean.
#LATKIT_OTLP_SPAN_MASKED=0

# ---------------------------------------------------------------------------
# TLS capture (stage 6)
# ---------------------------------------------------------------------------

# auto|off. 'auto' scans /proc for the libssl of matching processes, attaches
# SSL_read/SSL_write uprobes and rescans every 30 s. Needs CAP_SYS_PTRACE +
# CAP_SYS_ADMIN in the unit's CapabilityBoundingSet (see latkit.service).
#LATKIT_TLS=off

# Attach the SSL_* uprobes to this exact libssl path, skipping the /proc scan
# (e.g. a container's copy visible under /proc/<pid>/root/...).
#LATKIT_LIBSSL=

# With LATKIT_TLS=auto, scan only processes with this comm. The default scan set
# follows the protocols on LATKIT_PORT: {postgres, mysqld, mariadbd} for a
# database port, {nginx, httpd, apache2, haproxy} for an http one, {minio} for
# an s3 one, {redis-server, valkey-server, keydb-server} for a redis one, all of
# them for a mixed host. A `tls-port` Redis needs nothing else: every build
# measured links libssl dynamically, and the kernel-side uprobe gate is the scan
# set plus `io_thd_*` for the server's own io threads. Set e.g. LATKIT_TLS_COMM=mysqld to narrow it. This is the /proc
# *process* comm — unrelated to LATKIT_COMM above (the kernel per-thread capture
# filter). MariaDB with bundled wolfSSL/GnuTLS has no libssl to attach to — TLS
# is then detected and dropped-and-counted, not decrypted (docs/deploy.md).
#LATKIT_TLS_COMM=postgres

# TLS plaintext of a GO server (Caddy, Traefik, MinIO, any net/http): there is
# no libssl to scan for, so the binary is named instead and crypto/tls is probed
# inside it. Comma-separated, up to 4 paths. Stripped binaries work (Go's own
# function table is used when the ELF symbol table is gone). x86-64; a binary
# that cannot be hooked is fatal at startup rather than silently unobserved.
# Needs CAP_SYS_ADMIN (uprobes) but neither CAP_SYS_PTRACE nor a /proc scan.
# An s3 port has THIS CHANNEL AND NO OTHER: MinIO maps no libssl, so LATKIT_TLS
# =auto alone finds nothing and says so at startup instead of reporting a flat
# dashboard. The uprobe binds to an inode, so name the very file the server runs
# (for a containerised server: /proc/<pid>/root/usr/bin/minio).
#LATKIT_TLS_GO=/usr/bin/caddy

# ---------------------------------------------------------------------------
# Debug / diagnostics (all off by default; noisy — not for production)
# ---------------------------------------------------------------------------

# Append every raw ringbuf record to this file for offline replay (LKT1 trace).
# Remember to whitelist the directory via ReadWritePaths= in latkit.service.
#LATKIT_RECORD=

# One line per raw ringbuf event / reassembled message / query observation.
# Booleans.
#LATKIT_EVENTS=0
#LATKIT_MESSAGES=0
#LATKIT_QUERIES=0

# Hexdump payloads of LATKIT_EVENTS / LATKIT_MESSAGES output. Boolean.
#LATKIT_HEXDUMP=0

# Write the Prometheus exposition on SIGUSR1 and at exit: a bare boolean means
# stderr, any other value is the target path.
#LATKIT_DUMP_METRICS=0

# Test hook: switch every connection to HEADERS capture mode at OPEN. Boolean.
#LATKIT_CAP_HEADERS=0
