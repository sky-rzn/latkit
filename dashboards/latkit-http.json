          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(latkit_http_ttfb_seconds_bucket{proto=~\"$proto\"}[$__rate_interval])))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(latkit_http_ttfb_seconds_bucket{proto=~\"$proto\"}[$__rate_interval])))",
          "refId": "C",
          "range": true,
