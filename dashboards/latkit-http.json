                "id": "displayName",
                "value": "s/s"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "description": "Seconds of server time spent per second \u2014 the routes worth optimising, which are rarely the slowest ones."
