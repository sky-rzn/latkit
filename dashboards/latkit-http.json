          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "Top routes by p99 duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p99",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk($topk, histogram_quantile(0.99, sum by (le, method, route) (rate(latkit_http_request_duration_seconds_bucket{proto=~\"$proto\"}[$__rate_interval]))))",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "user": true,
              "proto": true,
              "host": true,
              "code": true
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p99"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
