          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(latkit_http_requests_total{proto=~\"$proto\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 21,
