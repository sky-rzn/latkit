      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk($topk, sum by (cmd) (rate(latkit_redis_commands_total{proto=~\"$proto\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{cmd}}"
        }
      ],
      "description": "Top commands by rate. `cmd` is a value from a closed table — the command and, for a container command, its subcommand (`CONFIG|GET`, `XINFO|STREAM`) — never a key and never an argument (РR4)."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PING",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
