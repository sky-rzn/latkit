      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(latkit_s3_request_duration_seconds_bucket{proto=~\"$proto\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "value"
        }
      ],
      "description": "Server-side: from the last byte of the request to the last byte of the response (РH5). A slow upload is not a slow server, and it is measured in its own panel."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error share",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(latkit_s3_errors_total{proto=~\"$proto\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(latkit_s3_requests_total{proto=~\"$proto\"}[$__rate_interval])), 0.001)",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "value"
        }
      ],
      "description": "Every failing operation, 4xx included: on an object store a 404 is routine (a client checking whether a key exists) and a 403 is not, so the split by code below is the panel to read, not this one."
    },
    {
