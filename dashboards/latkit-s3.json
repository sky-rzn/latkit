{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "sum(rate(latkit_ringbuf_dropped_total[$__rate_interval])) + sum(rate(latkit_resync_total[$__rate_interval])) > 0",
        "iconColor": "red",
        "name": "capture degraded",
        "titleFormat": "capture degraded",
        "textFormat": "ringbuf drops / resync in this window",
        "step": "$__rate_interval",
        "hide": false
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "latkit",
    "s3",
    "minio"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(latkit_s3_requests_total, proto)",
        "hide": 0,
        "includeAll": true,
        "label": "proto",
        "multi": true,
        "name": "proto",
        "options": [],
        "query": {
          "query": "label_values(latkit_s3_requests_total, proto)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "10",
          "value": "10"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Top-N",
        "multi": false,
        "name": "topk",
        "options": [],
        "query": "5,10,20",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": null,
  "timezone": "browser",
  "title": "latkit — S3 / MinIO",
  "uid": "latkit-s3",
  "version": 1,
  "links": null,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Operations/s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(latkit_s3_requests_total{proto=~\"$proto\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "value"
        }
      ],
      "description": "Every S3 API call the agent saw on the watched port. MinIO's own `/minio/…` traffic is not in here and not in any panel of this dashboard except \"Not an S3 API\" — on a distributed pool it is most of the requests on the port, and none of them is an S3 operation (РS2)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
