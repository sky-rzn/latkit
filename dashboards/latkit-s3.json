          "expr": "histogram_quantile(0.99, sum by (le) (rate(latkit_s3_object_size_bytes_bucket{proto=~\"$proto\"}[$__rate_interval])))",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "p99"
